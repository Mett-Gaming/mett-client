{
  "namespace": "pause",

  "mett_client_button@common_buttons.light_text_button": {
    "size": [ "100%", 28 ],
    "$button_text": "Mett-Client",
    "$pressed_button_name": "button.menu_continue",
    "$hover_button_texture": "textures/ui/mett_hover",
    "$pressed_button_texture": "textures/ui/mett_hover"
  },

  "mett_client_padding": {
    "type": "panel",
    "size": [ 0, 3 ]
  },

  "menu_background/button_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_after",
        "control_name": "settings",
        "value": [
          { "mett_client_button@pause.mett_client_button": {} },
          { "mett_client_padding@pause.mett_client_padding": {} }
        ]
      }
    ]
  }
}
